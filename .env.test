# Test Environment Configuration
# Usado para testes unitários e E2E
# Database separada para não poluir dev database

NODE_ENV=test
PORT=3001
API_URL=http://localhost:3001

# ============================================================================
# Test Database (ISOLADO)
# ============================================================================
# Use database separado: fastlead_test_db
# Antes de rodar testes, crie: createdb fastlead_test_db
DATABASE_URL=postgresql://fastlead_user:fastlead_password_dev@localhost:5432/fastlead_test_db
DATABASE_TEST_URL=postgresql://fastlead_user:fastlead_password_dev@localhost:5432/fastlead_test_db

# ============================================================================
# JWT (Test Keys)
# ============================================================================
JWT_SECRET=test-secret-key-only-for-testing-min-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=test-refresh-secret-key-only-for-testing
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
# CORS (Test Server)
# ============================================================================
CORS_ORIGIN=http://localhost:3001,http://localhost:3000,http://localhost:5173

# ============================================================================
# Logging (Test)
# ============================================================================
LOG_LEVEL=error
LOG_FORMAT=json

# ============================================================================
# Master Account (Testes)
# ============================================================================
MASTER_PASSWORD=test_master_password_123
