{
  "name": "fastlead-backend",
  "version": "0.1.0",
  "description": "FastLead - Advertising platform for tablets in taxis. Multi-tenant backend API.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:reset": "prisma migrate reset",
    "db:seed": "ts-node prisma/seed.ts",
    "db:seed:test": "TS_NODE_TRANSPILE_ONLY=1 ts-node prisma/seedTestUsers.ts",
    "db:reset:master": "TS_NODE_TRANSPILE_ONLY=1 ts-node prisma/resetAndSeedMaster.ts",
    "db:seed:demo": "TS_NODE_TRANSPILE_ONLY=1 ts-node prisma/seedContasDemo.ts",
    "postinstall": "prisma generate",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:validate": "prisma validate",
    "prisma:generate": "prisma generate"
  },
  "keywords": [
    "fastlead",
    "advertising",
    "multi-tenant",
    "api",
    "express",
    "typescript"
  ],
  "author": "FastLead Team",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "qrcode": "^1.5.4",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dietrichgebert/ponytail": "github:DietrichGebert/ponytail",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.6.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.5",
    "prisma": "^5.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
