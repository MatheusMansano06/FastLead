/// Pagamentos para motoristas
model Payment {
  id           String  @id @default(cuid())
  company_id   String
  motorista_id String
  campaign_id  String? // NULL se pagamento é fixo mensal

  amount       Decimal       @db.Decimal(12, 2)
  payment_type PaymentType   @default(PER_LEAD)
  status       PaymentStatus @default(PENDING)

  period_start DateTime @db.Date()
  period_end   DateTime @db.Date()

  leads_count Int @default(0)

  // Payment reference
  external_id     String?   @db.VarChar(255) // ID do gateway de pagamento
  paid_at         DateTime? @db.Timestamp()
  rejected_reason String?   @db.Text

  // Timestamps
  created_at DateTime @default(now()) @db.Timestamp()
  updated_at DateTime @updatedAt @db.Timestamp()

  // Relations
  company   Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  motorista MotoristProfile @relation("PaymentMotorista", fields: [motorista_id], references: [id], onDelete: Restrict)
  campaign  Campaign?       @relation(fields: [campaign_id], references: [id], onDelete: SetNull)

  @@index([company_id])
  @@index([motorista_id])
  @@index([status])
  @@index([period_start])
  @@index([period_end])
}

/// Transações de saldo da empresa (pré-pago)
/// Extrato da carteira do motorista: uma linha por ganho.
///
/// É a contraparte de `CompanyCreditTx` — quando um lead converte, a empresa é
/// debitada ali e o motorista é creditado aqui, na mesma transação. O saldo a
/// receber é a soma dos PENDING; `MotoristProfile.total_earnings` é só um
/// acumulado histórico e não deve ser usado para decidir quanto pagar.
///
/// `amount` é gravado no momento do ganho e nunca recalculado pela taxa atual —
/// mudar a comissão de 30% no futuro não pode reescrever o passado.
model DriverEarning {
  id           String  @id @default(cuid())
  motorista_id String
  company_id   String
  lead_id      String?
  campaign_id  String?

  /// Milissegundos de tela acumulados no dia que geraram este ganho.
  ///
  /// O valor é SEMPRE recalculado a partir deste total, nunca somado lote a
  /// lote: uma inserção de 10s a R$ 2,50/h vale R$ 0,00694 e arredondar cada
  /// lote para centavos faria o ganho derivar do tempo real ao longo do dia.
  screen_ms Int @default(0)

  /// Dia de competência. Uma linha por motorista/campanha/dia — sem isso o
  /// extrato viraria uma linha a cada inserção de 10 segundos.
  /// Nulo nos ganhos antigos, que eram por lead convertido.
  earned_date DateTime? @db.Date()

  amount          Decimal             @db.Decimal(12, 2)
  commission_rate Decimal             @db.Decimal(5, 4) // Taxa vigente no momento (ex.: 0.3000)
  status          DriverEarningStatus @default(PENDING)
  description     String?             @db.VarChar(255)

  // Repasse manual (PIX pelo painel do Mercado Pago)
  paid_at    DateTime? @db.Timestamp()
  payout_ref String?   @db.VarChar(120) // Comprovante/E2E do PIX
  paid_by    String? // user_id de quem marcou como pago

  created_at DateTime @default(now()) @db.Timestamp()
  updated_at DateTime @updatedAt @db.Timestamp()

  motorista MotoristProfile @relation(fields: [motorista_id], references: [id], onDelete: Cascade)
  company   Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  lead      Lead?           @relation(fields: [lead_id], references: [id], onDelete: SetNull)
  campaign  Campaign?       @relation(fields: [campaign_id], references: [id], onDelete: SetNull)

  /// Alvo do upsert do acúmulo diário. Nulos são distintos no Postgres, então
  /// os ganhos antigos por lead (campaign_id e earned_date nulos) não colidem.
  @@unique([motorista_id, campaign_id, earned_date])
  @@index([motorista_id, status])
  @@index([company_id])
  @@index([lead_id])
  @@index([campaign_id])
  @@index([created_at])
}

model CompanyCreditTx {
  id         String @id @default(cuid())
  company_id String

  type   CreditTransactionType
  amount Decimal               @db.Decimal(12, 2)

  // Referência do que gerou a transação
  campaign_id String? // Se é debit de campanha
  lead_id     String? // Se é lead convertido

  /// ID do pagamento no Mercado Pago. Único: é a trava de idempotência que
  /// impede creditar o mesmo depósito duas vezes quando o webhook e o /verify
  /// do cliente chegam para o mesmo pagamento.
  mercadopago_id String? @unique @db.VarChar(255)
  metadata       Json? // Dados extras (parcelas, taxa, etc)

  description String? @db.VarChar(255)

  // Snapshot do saldo após esta transação
  balance_after Decimal @db.Decimal(12, 2)

  // Timestamps
  created_at DateTime @default(now()) @db.Timestamp()

  // Relations
  company  Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaign_id], references: [id], onDelete: SetNull)
  lead     Lead?     @relation(fields: [lead_id], references: [id], onDelete: SetNull)

  @@index([company_id])
  @@index([type])
  @@index([created_at])
  @@index([campaign_id])
}

/// Conta bancária para recebimento de leads convertidos
model DriverBankAccount {
  id           String @id @default(cuid())
  motorista_id String @unique
  company_id   String

  // Dados da conta
  cpf          String @db.VarChar(14) // Proprietário (encrypted em produção)
  bank_code    String @db.VarChar(3) // Código do banco (001 Banco do Brasil, 033 Santander, etc)
  agency       String @db.VarChar(10)
  account      String @db.VarChar(20)
  account_type String @db.VarChar(20) // "CHECKING" ou "SAVINGS"
  holder_name  String @db.VarChar(255) // Nome do titular da conta

  status BankAccountStatus @default(PENDING_VERIFICATION)

  // Referência no Mercado Pago (se criamos transfer account lá)
  mercadopago_id String?   @db.VarChar(255)
  verified_at    DateTime? @db.Timestamp()

  // Timestamps
  created_at DateTime @default(now()) @db.Timestamp()
  updated_at DateTime @updatedAt @db.Timestamp()

  // Relations
  motorista MotoristProfile @relation(fields: [motorista_id], references: [id], onDelete: Cascade)
  company   Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([motorista_id])
  @@index([status])
}

// ============================================================================
// AUDIT & COMPLIANCE
// ============================================================================

/// Logs de auditoria para compliance
model AuditLog {
  id         String @id @default(cuid())
  company_id String
  user_id    String

  action        AuditAction
  resource_type String      @db.VarChar(100)
  resource_id   String      @db.VarChar(255)

  old_values  Json? // JSON das mudanças
  new_values  Json?
  description String? @db.Text

  ip_address String? @db.VarChar(50)
  user_agent String? @db.VarChar(500)

  // Timestamps
  created_at DateTime @default(now()) @db.Timestamp()

  // Relations
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([company_id])
  @@index([user_id])
  @@index([action])
  @@index([resource_type])
  @@index([created_at])
}

/// Avaliações e comentários de campanhas já finalizadas
model CampaignReview {
  id String @id @default(cuid())

  campaign_id  String
  motorista_id String

  rating  CampaignRating
  comment String?        @db.Text

  created_at DateTime @default(now()) @db.Timestamp()
  updated_at DateTime @updatedAt @db.Timestamp()

  // Relations
  campaign  Campaign        @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  motorista MotoristProfile @relation(fields: [motorista_id], references: [id], onDelete: Cascade)

  @@unique([campaign_id, motorista_id])
  @@index([campaign_id])
  @@index([motorista_id])
  @@index([created_at])
}

// ============================================================================
// ONBOARDING DO MOTORISTA — VERIFICAÇÃO DE IDENTIDADE E COMODATO
// ============================================================================

/// Pedido do motorista para colocar um tablet para rodar.
///
/// Todo motorista passa por aqui, inclusive quem já tem aparelho próprio: a
/// verificação de identidade é portão de entrada da plataforma, não só
/// garantia do equipamento. O que muda entre os dois caminhos é o comodato —
/// só quem leva tablet nosso assina contrato e recebe código de retirada.
///
/// Não há UNIQUE por motorista de propósito: recusa não é fim de linha, e
/// código expirado pode ser pedido de novo. O pedido que vale é sempre o mais
/// recente; os anteriores ficam como histórico de quem tentou o quê e quando.
model TabletRequest {
  id           String @id @default(cuid())
  company_id   String
  motorista_id String

  acquisition TabletAcquisition
  status      TabletRequestStatus @default(PENDING)

  /// Tentativa nº. Começa em 1 e sobe a cada novo pedido do mesmo motorista;
  /// três recusas seguidas é sinal de que alguém precisa olhar a conta.
  attempt Int @default(1)

  /// ----- Verificação de identidade -----
  /// Text e não VarChar: as fotos vêm como data-URL redimensionada no cliente,
  /// mesmo caminho de `User.avatar_url`. Documento precisa de mais resolução
  /// que um avatar, então cada linha aqui pesa algumas centenas de KB.
  ///
  /// São dado pessoal sensível: nunca devolver estes campos em listagem, só
  /// no detalhe de um pedido e só para ADMIN.
  selfie_photo    String @db.Text
  doc_front_photo String @db.Text
  doc_back_photo  String @db.Text

  /// ----- Análise -----
  reviewed_by_id   String?
  reviewed_at      DateTime? @db.Timestamp()
  rejection_reason String?   @db.VarChar(500)

  /// ----- Retirada (só no comodato) -----
  /// Código que o motorista mostra na tela e o sócio confere na entrega.
  /// Nasce na aprovação, não no envio: antes de aprovar não há o que retirar.
  /// UNIQUE aceita vários NULLs, então pedidos sem código não colidem.
  withdrawal_code       String?   @unique @db.VarChar(12)
  /// 48h a partir da aprovação. Passou disso vira EXPIRED e o motorista pede
  /// de novo — assim a fila de aprovados reflete quem realmente vai buscar.
  withdrawal_expires_at DateTime? @db.Timestamp()

  /// ----- Comodato -----
  /// Aceite feito na plataforma. A assinatura em papel continua acontecendo na
  /// entrega; isto aqui é o registro de que ele leu antes de sair de casa.
  contract_accepted_at DateTime? @db.Timestamp()
  /// Nome digitado pelo motorista no aceite, guardado como ele escreveu.
  contract_signature   String?   @db.VarChar(255)
  contract_ip          String?   @db.VarChar(50)
  /// Versão do texto aceito. Quando o contrato mudar, os aceites antigos
  /// continuam apontando para o que a pessoa de fato leu.
  contract_version     String?   @db.VarChar(20)

  /// ----- Entrega -----
  delivered_at      DateTime? @db.Timestamp()
  delivered_by_id   String?   @db.VarChar(30)
  /// Qual aparelho físico saiu. É o que liga pessoa ↔ tablet quando um
  /// sumir — sem isso o comodato não tem objeto.
  device_id         String?   @unique
  /// Anotado na entrega: número de série, patrimônio, o que o sócio usar.
  device_identifier String?   @db.VarChar(120)

  created_at DateTime @default(now()) @db.Timestamp()
  updated_at DateTime @updatedAt @db.Timestamp()

  company     Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  motorista   MotoristProfile @relation(fields: [motorista_id], references: [id], onDelete: Cascade)
  reviewed_by User?           @relation("TabletRequestReviewer", fields: [reviewed_by_id], references: [id], onDelete: SetNull)
  device      TabletDevice?   @relation(fields: [device_id], references: [id], onDelete: SetNull)

  @@index([company_id])
  @@index([motorista_id])
  @@index([status])
  @@index([created_at])
}
